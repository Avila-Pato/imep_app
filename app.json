{
  "expo": {
    "name": "Congrega",
    "slug": "imep_app",
    "description": "Turnos de servicio, anuncios, salas y Biblia para tu iglesia, en un solo lugar.",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "congrega",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#121212",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.avilapato.congrega",
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "congrega.expo.app",
              "pathPrefix": "/unirse"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#E5484D"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Congrega usa el micrófono para enviar notas de voz a tu grupo.",
          "recordAudioAndroid": true
        }
      ],
      "expo-sqlite",
      "expo-asset",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Congrega usa tu ubicación solo para marcar dónde está tu iglesia."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "63d1fb33-6dd5-47fd-9054-999c2a3e38ff"
      }
    }
  }
}
